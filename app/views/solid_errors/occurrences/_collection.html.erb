<% titled ||= false %>

<section id="occurrences" class="sm:rounded-md mt-4 -mx-2 sm:mx-0">
  <% if titled %>
    <div class="flex justify-between items-center mb-3 border-b">
      <h2 class="font-bold text-2xl">
        Occurrences
      </h2>
      <div class="flex gap-x-4 pb-2">
        <p class="text-right">
          <% page_count = page.count %>
          <% if page_count.zero? %>
            No occurrences found
          <% elsif page.pages == 1 %>
            <strong><%= page_count %></strong> total
          <% else %>
            <strong><%= page.from %>-<%= page.to %></strong> of <strong><%= page_count %></strong>
          <% end %>
        </p>

        <nav aria-label="Pages">
          <% if (first_page = page.first) %>
            <a href="<%= url_for(page: first_page, items: params[:items]) %>" aria-label="First" class="border border-black text-black bg-white py-1 px-2 cursor-pointer hover:bg-black hover:text-white">&laquo;</a>
          <% else %>
            <a role="link" aria-disabled="true" aria-label="First" class="border text-gray-500 bg-white py-1 px-2">&laquo;</a>
          <% end %>

          <% if (prev_page = page.prev) %>
            <a href="<%= url_for(page: prev_page, items: params[:items]) %>" aria-label="Previous" class="border border-black text-black bg-white py-1 px-2 cursor-pointer hover:bg-black hover:text-white">&lsaquo;</a>
          <% else %>
            <a role="link" aria-disabled="true" aria-label="Previous" class="border text-gray-500 bg-white py-1 px-2">&lsaquo;</a>
          <% end %>

          <% if (next_page = page.next) %>
            <a href="<%= url_for(page: next_page, items: params[:items]) %>" aria-label="Next" class="border border-black text-black bg-white py-1 px-2 cursor-pointer hover:bg-black hover:text-white">&rsaquo;</a>
          <% else %>
            <a role="link" aria-disabled="true" aria-label="Next" class="border text-gray-500 bg-white py-1 px-2">&rsaquo;</a>
          <% end %>

          <% if (last_page = page.last) %>
            <a href="<%= url_for(page: last_page, items: params[:items]) %>" aria-label="Last" class="border border-black text-black bg-white py-1 px-2 cursor-pointer hover:bg-black hover:text-white">&raquo;</a>
          <% else %>
            <a role="link" aria-disabled="true" aria-label="Last" class="border text-gray-500 bg-white py-1 px-2">&raquo;</a>
          <% end %>
        </nav>
      </div>
    </div>
  <% end %>

  <div class="min-w-full">
    <% if occurrences.any? %>
      <%= render partial: "solid_errors/occurrences/occurrence",
            collection: occurrences, as: :occurrence %>
    <% else %>
      <div class="flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-list-ul" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m-3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
        </svg>
        <span class="text-2xl">No occurrences yet&hellip;</span>
      </div>
    <% end %>
  </div>
</section>
