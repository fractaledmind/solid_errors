<% seen_at = occurrence.created_at %>
<% backtrace = occurrence.parsed_backtrace %>
<% open ||= defined?(occurrence_counter) ? occurrence_counter.zero? : true %>

<%= tag.section id: dom_id(occurrence), class: "" do %>
  <%= tag.details open: open do %>
    <summary class="hover:bg-gray-50 p-2 rounded cursor-pointer">
      <%= time_tag seen_at, seen_at %>
      (<em><%= time_ago_in_words(seen_at) %> ago</em>)
    </summary>
    <div class="">
      <dl class="ml-6">
        <% occurrence.context&.each do |key, value| %>
          <div class="flex items-center justify-start flex-wrap gap-x-2">
            <dt class="font-bold">
              <%= SolidErrors::Occurrence.human_attribute_name(key) %>
            </dt>
            <dd class="">
              <code><%= value %></code>
            </dd>
          </div>
        <% end %>
        <div class="">
          <dt class="font-bold">
            <%= SolidErrors::Occurrence.human_attribute_name(:backtrace) %>
          </dt>
          <dd class="">
            <div class="flex gap-2 mb-3">
              <button type="button"
                      data-backtrace-toggle="application"
                      data-occurrence-id="<%= occurrence.id %>"
                      class="backtrace-toggle inline-flex items-center border-b-2 px-3 py-2 text-sm font-medium cursor-pointer border-blue-500 text-blue-500">
                Application
              </button>
              <button type="button"
                      data-backtrace-toggle="full"
                      data-occurrence-id="<%= occurrence.id %>"
                      class="backtrace-toggle inline-flex items-center border-b-2 px-3 py-2 text-sm font-medium cursor-pointer border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
                Full
              </button>
            </div>

            <div id="backtrace-application-<%= occurrence.id %>">
              <% if backtrace.application_lines.empty? %>
                <p class="text-gray-500 text-sm">
                  <em>No application code in backtrace.</em>
                  <button type="button" data-backtrace-toggle="full" data-occurrence-id="<%= occurrence.id %>" class="text-blue-500 hover:underline cursor-pointer">
                    View full trace
                  </button>
                </p>
              <% else %>
                <%= render partial: "solid_errors/occurrences/backtrace_line", collection: backtrace.application_lines, as: :line, locals: {open: true} %>
              <% end %>
            </div>

            <div id="backtrace-full-<%= occurrence.id %>" hidden>
              <% backtrace.lines.each_with_index do |line, i| %>
                <%= render "solid_errors/occurrences/backtrace_line", line: line, open: line.application? || i.zero? %>
              <% end %>
            </div>
          </dd>
        </div>
      </dl>
    </div>
  <% end %>
<% end %>

<hr class="mt-4 pb-4">
